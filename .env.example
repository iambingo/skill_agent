INSTALL_METHOD=remote
REMOTE_INSTALL_URL=debug.dify.ai:5003
REMOTE_INSTALL_KEY=********-****-****-****-************
# Debug模式下，Dify文件URL使用内部Docker地址(http://api:5001)，需配置为宿主机可访问的地址
# 例如本地部署: DIFY_API_URL=http://localhost
# 例如远程部署: DIFY_API_URL=https://your-dify-domain.com
DIFY_API_URL=http://localhost
